# ==============================================================================
# Hospital Management System (HMS) - Example Environment Configuration
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# Core Settings & Security Keys
DEBUG=True
SECRET_KEY=your-django-secret-key
JWT_SIGNING_KEY=your-jwt-signing-key-different-from-secret-key
ENCRYPTION_KEY=your-fernet-encryption-key-generate-via-cryptography-fernet

# Database Configuration (PostgreSQL / Neon)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# AI Health Assistant Settings
# LLM_PROVIDER options: 'auto', 'gemini', or 'deterministic'
# When set to 'auto' without an API key, it uses the offline Deterministic RAG engine (zero hallucinations).
LLM_PROVIDER=auto
GEMINI_API_KEY=your-gemini-api-key-optional
LLM_MODEL=gemini-1.5-flash

# API Rate Limiting / Throttling
THROTTLE_ANON_RATE=60/minute
THROTTLE_USER_RATE=1000/minute

# Email Configuration (SMTP Gmail)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

# Password Reset Token
PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=24

# Frontend URL & Host Permissions
FRONTEND_URL=http://localhost:8080
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,http://127.0.0.1:3000

# Google OAuth (Optional)
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
